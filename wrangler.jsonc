{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visitor-counter",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "routes": [{ "pattern": "vc.hellojyp.com", "custom_domain": true }],
  "vars": {
    "SITES": "{\"6nimmt\":[\"https://6nimmt.hellojyp.com\"],\"map-for-ppt\":[\"https://map.hellojyp.com\"]}",
    "TIME_ZONE": "Asia/Seoul"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "db",
    "database_id": "b64af875-6c31-4184-bd93-a5aef0bb68fc",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["17 18 * * *"] }
}
